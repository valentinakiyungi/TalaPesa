# ---------------------------------------------------------------
# TalaPesa environment variables. Copy to .env.local and fill in.
# ---------------------------------------------------------------

# Public Firebase web config (Firebase console -> Project settings -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=esncash.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=esncash
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=esncash.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public URL of the deployed app (used in invite links and payment callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server: Firebase service account JSON, base64-encoded on one line.
#   base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Comma-separated emails that get the platform admin console (/admin)
PLATFORM_ADMIN_EMAILS=valentinakiyungi@gmail.com

# Secret for the daily job (overdue updates + SMS reminders). Any long random string.
CRON_SECRET=

# --- Platform billing (subscriptions paid by lenders to you) via Selcom ---
# Leave empty to run billing in TEST MODE (a simulated checkout page).
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=
SELCOM_BASE_URL=https://apigw.selcommobile.com

# Set to "true" only for local development with the Firebase emulators
NEXT_PUBLIC_USE_EMULATORS=false
